# Doxygen configuration for ADS1115
# Generated and maintained for unified API documentation.

PROJECT_NAME           = "ADS1115"
PROJECT_NUMBER         = "2.0.1"
PROJECT_BRIEF          = "ADS1115 embedded library API documentation"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO

SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
STRIP_CODE_COMMENTS    = NO

INPUT                  = README.md \
                         CHANGELOG.md \
                         include \
                         docs/OPEN_ITEMS.md \
                         docs/IDF_PORT.md \
                         docs/ADS1115_HARDWARE_VALIDATION_PLAN.md \
                         docs/ADS1115_HARDWARE_VALIDATION_RESULTS_TEMPLATE.md
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
# Guards only: INPUT above names explicit files, so these match nothing today.
# They exist so re-widening INPUT to the docs/ directory cannot sweep in the
# generated HTML or the TI datasheet transcripts. Single-segment patterns are
# deliberately avoided: doxygen matches these against the absolute path, so a
# pattern like */test/* would exclude every input under a checkout whose path
# happens to contain a "test" segment.
EXCLUDE_PATTERNS       = */docs/doxygen/* */docs/reference/*
EXCLUDE_SYMBOLS        = ADS1115_VERSION_STRING ADS1115_BUILD_DATE \
                         ADS1115_BUILD_TIME ADS1115_BUILD_TIMESTAMP \
                         ADS1115_GIT_COMMIT ADS1115_GIT_STATUS \
                         ADS1115_VERSION_FULL
USE_MDFILE_AS_MAINPAGE = README.md
FULL_PATH_NAMES        = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
HAVE_DOT               = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
